# Copy to .env and replace every change-me value with a distinct password.
# .env is ignored by Git; this file contains placeholders only.
# Host address the UI (8080) and the API (8000) are published on. Loopback:
# the API has write routes and no authentication, so it is reachable from this
# machine only. Do NOT widen this to 0.0.0.0 on a shared host until the API
# has authenticated, authorised writes -- see "Security" in the README.
AOW_BIND_ADDR=127.0.0.1

POSTGRES_USER=aow
POSTGRES_DB=aow
POSTGRES_PASSWORD=change-me
POSTGRES_WRITER_PASSWORD=change-me
POSTGRES_READER_PASSWORD=change-me

RABBITMQ_USER=aow
RABBITMQ_PASSWORD=change-me

LLM_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
LLM_MODEL=Qwen3-1.7B-Q4_K_M
# llama.cpp splits the context between slots, so this is 4096 per slot at the
# default LLM_PARALLEL=2. Raise both together, never just one.
LLM_CTX_SIZE=8192
# Two slots: one for the enricher's backlog, one to keep the agent's chat
# responsive while that backlog drains.
LLM_PARALLEL=2
LLM_THREADS=4

ENRICH_POLL_SECONDS=60
ENRICH_BATCH=8
# How many of each city-day's activities the local model is asked to word.
# The rule engine scores all 18 regardless -- that is the product and it is
# free. Wording all of them is ~1,300 CPU generations per refresh, so the
# consumer ranks each day and stores the rest 'deferred'. Raise it on a GPU.
ENRICH_TOP_N=6
